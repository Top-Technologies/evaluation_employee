<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="module_category_evaluation" model="ir.module.category">
            <field name="name">Employee Evaluation</field>
            <field name="sequence">10</field>
        </record>

        <!-- Groups -->
        <record id="group_evaluation_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="category_id" ref="module_category_evaluation"/>
        </record>

        <!-- Make Employee default for new users -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_evaluation_employee'))]"/>
        </record>

        <record id="group_evaluation_coach" model="res.groups">
            <field name="name">Coach</field>
            <field name="category_id" ref="module_category_evaluation"/>
            <field name="implied_ids" eval="[(4, ref('group_evaluation_employee'))]"/>
        </record>

        <record id="group_evaluation_hr" model="res.groups">
            <field name="name">HR Manager</field>
            <field name="category_id" ref="module_category_evaluation"/>
            <field name="implied_ids" eval="[(4, ref('group_evaluation_coach'))]"/>
        </record>


        <!-- Record Rules -->

        <!-- ==================== 3 MONTH EVALUATION ==================== -->
        <!-- Employee: Can see ONLY their own evaluations -->
        <record id="rule_emp_evaluation_employee" model="ir.rule">
            <field name="name">Employee: Own 3-Month Evaluations</field>
            <field name="model_id" ref="model_emp_evaluation"/>
            <field name="groups" eval="[(4, ref('group_evaluation_employee'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Coach: Can see evaluations they created or where they are Coach/Manager -->
        <record id="rule_emp_evaluation_coach" model="ir.rule">
            <field name="name">Coach: Subordinates 3-Month Evaluations</field>
            <field name="model_id" ref="model_emp_evaluation"/>
            <field name="groups" eval="[(4, ref('group_evaluation_coach'))]"/>
            <field name="domain_force">['|', '|', ('create_uid', '=', user.id), ('employee_id.coach_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
        </record>

        <!-- HR: Can see all evaluations -->
        <record id="rule_emp_evaluation_hr" model="ir.rule">
            <field name="name">HR: All 3-Month Evaluations</field>
            <field name="model_id" ref="model_emp_evaluation"/>
            <field name="groups" eval="[(4, ref('group_evaluation_hr'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ==================== 60 DAYS EVALUATION ==================== -->
        <!-- Employee -->
        <record id="rule_emp_evaluation_sixty_employee" model="ir.rule">
            <field name="name">Employee: Own 60-Day Evaluations</field>
            <field name="model_id" ref="model_emp_evaluation_sixty"/>
            <field name="groups" eval="[(4, ref('group_evaluation_employee'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Coach -->
        <record id="rule_emp_evaluation_sixty_coach" model="ir.rule">
            <field name="name">Coach: Subordinates 60-Day Evaluations</field>
            <field name="model_id" ref="model_emp_evaluation_sixty"/>
            <field name="groups" eval="[(4, ref('group_evaluation_coach'))]"/>
            <field name="domain_force">['|', '|', ('create_uid', '=', user.id), ('employee_id.coach_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
        </record>

        <!-- HR -->
        <record id="rule_emp_evaluation_sixty_hr" model="ir.rule">
            <field name="name">HR: All 60-Day Evaluations</field>
            <field name="model_id" ref="model_emp_evaluation_sixty"/>
            <field name="groups" eval="[(4, ref('group_evaluation_hr'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ==================== 90 DAYS EVALUATION ==================== -->
        <!-- Employee -->
        <record id="rule_emp_evaluation_ninety_employee" model="ir.rule">
            <field name="name">Employee: Own 90-Day Evaluations</field>
            <field name="model_id" ref="model_emp_evaluation_ninety"/>
            <field name="groups" eval="[(4, ref('group_evaluation_employee'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Coach -->
        <record id="rule_emp_evaluation_ninety_coach" model="ir.rule">
            <field name="name">Coach: Subordinates 90-Day Evaluations</field>
            <field name="model_id" ref="model_emp_evaluation_ninety"/>
            <field name="groups" eval="[(4, ref('group_evaluation_coach'))]"/>
            <field name="domain_force">['|', '|', ('create_uid', '=', user.id), ('employee_id.coach_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
        </record>

        <!-- HR -->
        <record id="rule_emp_evaluation_ninety_hr" model="ir.rule">
            <field name="name">HR: All 90-Day Evaluations</field>
            <field name="model_id" ref="model_emp_evaluation_ninety"/>
            <field name="groups" eval="[(4, ref('group_evaluation_hr'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ==================== HR EVALUATION ==================== -->
        <!-- Employee -->
        <record id="rule_emp_evaluation_hr_employee" model="ir.rule">
            <field name="name">Employee: Own HR Evaluations</field>
            <field name="model_id" ref="model_emp_evaluation_hr"/>
            <field name="groups" eval="[(4, ref('group_evaluation_employee'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Coach -->
        <record id="rule_emp_evaluation_hr_coach" model="ir.rule">
            <field name="name">Coach: Subordinates HR Evaluations</field>
            <field name="model_id" ref="model_emp_evaluation_hr"/>
            <field name="groups" eval="[(4, ref('group_evaluation_coach'))]"/>
            <field name="domain_force">['|', '|', ('create_uid', '=', user.id), ('employee_id.coach_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
        </record>

        <!-- HR -->
        <record id="rule_emp_evaluation_hr_hr" model="ir.rule">
            <field name="name">HR: All HR Evaluations</field>
            <field name="model_id" ref="model_emp_evaluation_hr"/>
            <field name="groups" eval="[(4, ref('group_evaluation_hr'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
