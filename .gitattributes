# Ensure all text files are treated as UTF-8
* text=auto encoding=utf-8

# Explicitly mark source files as text with UTF-8 encoding
*.py text encoding=utf-8
*.xml text encoding=utf-8
*.csv text encoding=utf-8
*.txt text encoding=utf-8
*.md text encoding=utf-8
*.json text encoding=utf-8
*.js text encoding=utf-8
*.css text encoding=utf-8
*.html text encoding=utf-8
*.po text encoding=utf-8
*.pot text encoding=utf-8

# Binary files - do not modify
*.pyc binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
